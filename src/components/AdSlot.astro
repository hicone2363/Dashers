---
import { SITE_CONFIG } from '../data/config';

export interface Props {
  slotType?: 'leaderboard' | 'inlineRectangle' | 'mobileBanner';
  slotId?: string;
  className?: string;
}

const { slotType = 'inlineRectangle', slotId = 'ad-slot', className = '' } = Astro.props;

// Hidden by default until site is approved by ad networks
const isEnabled = SITE_CONFIG.adSlots?.enabled ?? false;

const dimensions = {
  leaderboard: {
    wrapperClass: 'min-h-[90px] w-full max-w-[728px]',
    heightClass: 'h-[90px]',
  },
  inlineRectangle: {
    wrapperClass: 'min-h-[250px] w-full max-w-[300px]',
    heightClass: 'h-[250px]',
  },
  mobileBanner: {
    wrapperClass: 'min-h-[100px] w-full max-w-[320px]',
    heightClass: 'h-[100px]',
  },
}[slotType];
---

{isEnabled && (
  <aside
    class:list={[
      'my-6 mx-auto flex flex-col items-center justify-center overflow-hidden rounded-md text-center',
      dimensions.wrapperClass,
      className
    ]}
    aria-label="Advertisement"
  >
    <div
      id={slotId}
      class:list={[
        'flex w-full items-center justify-center text-xs',
        dimensions.heightClass
      ]}
    >
      <!-- Ad network tags inject here dynamically -->
    </div>
  </aside>
)}
