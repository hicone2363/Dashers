---
export interface BreadcrumbItem {
  name: string;
  url: string;
}

export interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="py-3 text-sm text-slate-500 dark:text-slate-400">
  <ol class="flex flex-wrap items-center gap-1.5 list-none p-0 m-0">
    <li class="inline-flex items-center">
      <a
        href="/"
        class="inline-flex items-center hover:text-brand-600 dark:hover:text-brand-400 font-medium transition-colors"
      >
        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
        </svg>
        Home
      </a>
    </li>
    {items.map((item, index) => {
      const isLast = index === items.length - 1;
      return (
        <li class="inline-flex items-center">
          <span class="mx-1 text-slate-400" aria-hidden="true">/</span>
          {isLast ? (
            <span class="text-slate-900 dark:text-slate-100 font-semibold" aria-current="page">
              {item.name}
            </span>
          ) : (
            <a
              href={item.url}
              class="hover:text-brand-600 dark:hover:text-brand-400 font-medium transition-colors"
            >
              {item.name}
            </a>
          )}
        </li>
      );
    })}
  </ol>
</nav>
