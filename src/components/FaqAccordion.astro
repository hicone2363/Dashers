---
export interface FaqItem {
  question: string;
  answer: string;
}

export interface Props {
  faqs: FaqItem[];
  title?: string;
}

const { faqs, title = "Frequently Asked Questions" } = Astro.props;
---

{faqs && faqs.length > 0 && (
  <section class="my-10" aria-labelledby="faq-heading">
    <h2 id="faq-heading" class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white mb-4">
      {title}
    </h2>
    <div class="space-y-3">
      {faqs.map((faq, index) => (
        <details class="group rounded-xl border border-slate-200 bg-white p-4 transition-colors hover:border-slate-300 dark:border-slate-800 dark:bg-slate-900/80 dark:hover:border-slate-700">
          <summary class="flex cursor-pointer items-center justify-between font-semibold text-slate-900 dark:text-slate-100 min-h-[44px] select-none text-base">
            <span class="pr-4">{faq.question}</span>
            <span class="ml-2 flex-shrink-0 text-slate-400 group-open:rotate-180 transition-transform">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </span>
          </summary>
          <div class="mt-3 pt-3 border-t border-slate-100 dark:border-slate-800 text-slate-600 dark:text-slate-300 text-sm leading-relaxed">
            <p>{faq.answer}</p>
          </div>
        </details>
      ))}
    </div>
  </section>
)}
