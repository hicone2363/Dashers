---
import { SITE_CONFIG } from '../data/config';

const pathname = Astro.url.pathname;
---

<header class="sticky top-0 z-40 w-full border-b border-slate-200 bg-white/95 backdrop-blur dark:border-slate-800 dark:bg-slate-900/95">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
    <!-- Brand Logo & Name -->
    <a href="/" class="flex items-center gap-2.5 font-bold text-xl tracking-tight text-slate-900 dark:text-white group">
      <span class="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-brand-500 text-white font-extrabold shadow-sm group-hover:bg-brand-600 transition-colors">
        DM
      </span>
      <span>
        {SITE_CONFIG.siteName}
        <span class="hidden sm:inline-block text-xs font-semibold uppercase tracking-wider text-brand-600 dark:text-brand-400 bg-brand-50 dark:bg-brand-950 px-2 py-0.5 rounded ml-1.5 border border-brand-100 dark:border-brand-900">
          Independent
        </span>
      </span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-1" aria-label="Main Navigation">
      {SITE_CONFIG.navItems.map((item) => {
        const isActive = pathname === item.href || (item.href !== '/' && pathname.startsWith(item.href));
        return (
          <a
            href={item.href}
            class:list={[
              'px-3.5 py-2 rounded-md text-sm font-medium transition-colors min-h-[44px] flex items-center',
              isActive
                ? 'bg-slate-100 text-brand-600 dark:bg-slate-800 dark:text-brand-400 font-semibold'
                : 'text-slate-700 hover:text-slate-900 hover:bg-slate-50 dark:text-slate-300 dark:hover:text-white dark:hover:bg-slate-800/60'
            ]}
          >
            {item.label}
          </a>
        );
      })}
    </nav>

    <!-- Header Action Button (Calculator CTA) -->
    <div class="hidden sm:flex items-center gap-3">
      <a
        href="/tools/is-this-order-worth-it/"
        class="inline-flex items-center justify-center rounded-lg bg-brand-500 px-4 py-2 text-sm font-semibold text-white shadow hover:bg-brand-600 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600 transition-colors min-h-[44px]"
      >
        Order Calculator
      </a>
    </div>

    <!-- Mobile Menu Button -->
    <button
      id="mobile-menu-btn"
      type="button"
      class="md:hidden inline-flex items-center justify-center rounded-md p-2.5 text-slate-700 hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-800 min-h-[44px] min-w-[44px]"
      aria-label="Toggle navigation menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg class="h-6 w-6 block" id="icon-menu-open" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
      </svg>
      <svg class="h-6 w-6 hidden" id="icon-menu-close" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Mobile Dropdown Navigation -->
  <div id="mobile-menu" class="hidden md:hidden border-b border-slate-200 bg-white px-4 pt-2 pb-4 dark:border-slate-800 dark:bg-slate-900">
    <div class="flex flex-col space-y-1">
      {SITE_CONFIG.navItems.map((item) => {
        const isActive = pathname === item.href;
        return (
          <a
            href={item.href}
            class:list={[
              'block rounded-md px-3 py-3 text-base font-medium min-h-[44px] flex items-center',
              isActive
                ? 'bg-slate-100 text-brand-600 dark:bg-slate-800 dark:text-brand-400 font-semibold'
                : 'text-slate-700 hover:bg-slate-50 hover:text-slate-900 dark:text-slate-300 dark:hover:bg-slate-800'
            ]}
          >
            {item.label}
          </a>
        );
      })}
      <div class="pt-2">
        <a
          href="/tools/is-this-order-worth-it/"
          class="flex w-full items-center justify-center rounded-lg bg-brand-500 px-4 py-3 text-base font-semibold text-white shadow hover:bg-brand-600 min-h-[48px]"
        >
          Check Order Profitability
        </a>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-menu-open');
  const iconClose = document.getElementById('icon-menu-close');

  if (btn && menu && iconOpen && iconClose) {
    btn.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!isExpanded));
      menu.classList.toggle('hidden');
      iconOpen.classList.toggle('hidden');
      iconClose.classList.toggle('hidden');
    });
  }
</script>
