---
import { SITE_CONFIG } from '../data/config';

const pathname = Astro.url.pathname;

const guideLinks = [
  { label: "Earn by Time Mode", href: "/earn-by-time-doordash/" },
  { label: "Pay Per Delivery (Base Pay & Tips)", href: "/doordash-pay-per-delivery/" },
  { label: "Does DoorDash Pay Hourly?", href: "/does-doordash-pay-hourly/" },
  { label: "Does DoorDash Pay For Gas?", href: "/does-doordash-pay-for-gas/" },
];
---

<header class="sticky top-0 z-40 w-full border-b border-slate-200 bg-white/95 backdrop-blur dark:border-slate-800 dark:bg-slate-900/95">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
    <!-- Brand Logo & Name -->
    <a href="/" class="flex items-center gap-2.5 font-bold text-xl tracking-tight text-slate-900 dark:text-white group">
      <span class="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-brand-500 text-white font-extrabold shadow-sm group-hover:bg-brand-600 transition-colors">
        DM
      </span>
      <span>
        {SITE_CONFIG.siteName}
        <span class="hidden sm:inline-block text-xs font-semibold uppercase tracking-wider text-brand-600 dark:text-brand-400 bg-brand-50 dark:bg-brand-950 px-2 py-0.5 rounded ml-1.5 border border-brand-100 dark:border-brand-900">
          Independent
        </span>
      </span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-2" aria-label="Main Navigation">
      <a
        href="/"
        class:list={[
          'px-3.5 py-2 rounded-md text-sm font-medium transition-colors min-h-[44px] flex items-center',
          pathname === '/'
            ? 'bg-slate-100 text-brand-600 dark:bg-slate-800 dark:text-brand-400 font-semibold'
            : 'text-slate-700 hover:text-slate-900 hover:bg-slate-50 dark:text-slate-300 dark:hover:text-white dark:hover:bg-slate-800/60'
        ]}
      >
        Home
      </a>

      <!-- Guides Dropdown Menu -->
      <div class="relative group">
        <button
          type="button"
          class:list={[
            'px-3.5 py-2 rounded-md text-sm font-medium transition-colors min-h-[44px] flex items-center gap-1.5 group',
            pathname.includes('earn') || pathname.includes('pay') || pathname.includes('hourly') || pathname.includes('gas')
              ? 'text-brand-600 dark:text-brand-400 font-semibold'
              : 'text-slate-700 hover:text-slate-900 hover:bg-slate-50 dark:text-slate-300 dark:hover:text-white dark:hover:bg-slate-800/60'
          ]}
          aria-expanded="false"
        >
          <span>Guides</span>
          <svg class="w-4 h-4 text-slate-400 group-hover:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <div class="absolute left-0 top-full hidden group-hover:block group-focus-within:block w-72 pt-2 shadow-lg rounded-xl z-50">
          <div class="rounded-xl border border-slate-200 bg-white p-2 shadow-xl dark:border-slate-800 dark:bg-slate-900">
            {guideLinks.map((g) => (
              <a
                href={g.href}
                class="block px-3 py-2.5 rounded-lg text-sm font-medium text-slate-700 hover:bg-slate-50 hover:text-brand-600 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-brand-400 transition-colors"
              >
                {g.label}
              </a>
            ))}
          </div>
        </div>
      </div>

      <a
        href="/about/"
        class:list={[
          'px-3.5 py-2 rounded-md text-sm font-medium transition-colors min-h-[44px] flex items-center',
          pathname === '/about/'
            ? 'bg-slate-100 text-brand-600 dark:bg-slate-800 dark:text-brand-400 font-semibold'
            : 'text-slate-700 hover:text-slate-900 hover:bg-slate-50 dark:text-slate-300 dark:hover:text-white dark:hover:bg-slate-800/60'
        ]}
      >
        About
      </a>
    </nav>

    <!-- Header Action Button (Calculator CTA) -->
    <div class="hidden sm:flex items-center gap-3">
      <a
        href="/tools/is-this-order-worth-it/"
        class="inline-flex items-center justify-center rounded-lg bg-brand-500 px-4 py-2 text-sm font-semibold text-white shadow hover:bg-brand-600 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600 transition-colors min-h-[44px]"
      >
        Order Calculator
      </a>
    </div>

    <!-- Mobile Menu Button -->
    <button
      id="mobile-menu-btn"
      type="button"
      class="md:hidden inline-flex items-center justify-center rounded-md p-2.5 text-slate-700 hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-800 min-h-[44px] min-w-[44px]"
      aria-label="Toggle navigation menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg class="h-6 w-6 block" id="icon-menu-open" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
      </svg>
      <svg class="h-6 w-6 hidden" id="icon-menu-close" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Mobile Dropdown Navigation -->
  <div id="mobile-menu" class="hidden md:hidden border-b border-slate-200 bg-white px-4 pt-2 pb-4 dark:border-slate-800 dark:bg-slate-900">
    <div class="flex flex-col space-y-1">
      <a
        href="/"
        class:list={[
          'block rounded-md px-3 py-2.5 text-base font-medium min-h-[44px] flex items-center',
          pathname === '/'
            ? 'bg-slate-100 text-brand-600 dark:bg-slate-800 dark:text-brand-400 font-semibold'
            : 'text-slate-700 hover:bg-slate-50 hover:text-slate-900 dark:text-slate-300 dark:hover:bg-slate-800'
        ]}
      >
        Home
      </a>

      <div class="pt-2 pb-1 px-3 text-xs font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">
        Driver Guides
      </div>
      {guideLinks.map((g) => (
        <a
          href={g.href}
          class="block rounded-md pl-6 pr-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 hover:text-slate-900 dark:text-slate-300 dark:hover:bg-slate-800"
        >
          {g.label}
        </a>
      ))}

      <a
        href="/about/"
        class:list={[
          'block rounded-md px-3 py-2.5 text-base font-medium min-h-[44px] flex items-center',
          pathname === '/about/'
            ? 'bg-slate-100 text-brand-600 dark:bg-slate-800 dark:text-brand-400 font-semibold'
            : 'text-slate-700 hover:bg-slate-50 hover:text-slate-900 dark:text-slate-300 dark:hover:bg-slate-800'
        ]}
      >
        About
      </a>

      <div class="pt-3">
        <a
          href="/tools/is-this-order-worth-it/"
          class="flex w-full items-center justify-center rounded-lg bg-brand-500 px-4 py-3 text-base font-semibold text-white shadow hover:bg-brand-600 min-h-[48px]"
        >
          Order Profit Calculator
        </a>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-menu-open');
  const iconClose = document.getElementById('icon-menu-close');

  if (btn && menu && iconOpen && iconClose) {
    btn.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!isExpanded));
      menu.classList.toggle('hidden');
      iconOpen.classList.toggle('hidden');
      iconClose.classList.toggle('hidden');
    });
  }
</script>
