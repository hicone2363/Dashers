---
export interface HeadingItem {
  depth: number;
  slug: string;
  text: string;
}

export interface Props {
  headings: HeadingItem[];
}

const { headings } = Astro.props;
const filteredHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{filteredHeadings.length > 0 && (
  <nav aria-label="Table of Contents" class="my-6 rounded-xl border border-slate-200 bg-slate-50/80 p-4 dark:border-slate-800 dark:bg-slate-900/60">
    <div class="flex items-center justify-between pb-2 mb-2 border-b border-slate-200/80 dark:border-slate-800">
      <span class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
        <svg class="w-4 h-4 text-brand-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" />
        </svg>
        In This Guide
      </span>
      <span class="text-[11px] text-slate-500">Jump to section</span>
    </div>
    <ul class="space-y-1.5 text-sm">
      {filteredHeadings.map((heading) => (
        <li class={heading.depth === 3 ? 'pl-4 text-xs' : 'font-medium'}>
          <a
            href={`#${heading.slug}`}
            class="text-slate-700 hover:text-brand-600 dark:text-slate-300 dark:hover:text-brand-400 transition-colors inline-block py-0.5"
          >
            {heading.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}
