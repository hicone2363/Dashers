---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE_CONFIG } from '../data/config';

const title = `Contact Us & Reader Feedback | ${SITE_CONFIG.siteName}`;
const description = `Contact the independent research and development team at ${SITE_CONFIG.siteName}. Suggest calculator updates, report algorithmic shifts, or ask questions.`;

const breadcrumbs = [
  { name: 'Contact', url: '/contact/' }
];
---

<BaseLayout
  title={title}
  description={description}
  canonicalUrl={Astro.url.href}
  breadcrumbs={breadcrumbs}
>
  <div class="mx-auto max-w-4xl px-4 py-8 sm:px-6 sm:py-12">
    <Breadcrumbs items={breadcrumbs} />

    <header class="mb-8">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white">
        Contact {SITE_CONFIG.siteName}
      </h1>
      <p class="mt-2 text-lg text-slate-600 dark:text-slate-300">
        Feedback from active drivers powers our calculators and guides.
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <!-- Contact Information & Instructions -->
      <div class="space-y-6 text-slate-700 dark:text-slate-300">
        <div class="rounded-xl border border-slate-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-900 shadow-sm">
          <h2 class="text-xl font-bold text-slate-900 dark:text-white mb-3">
            Direct Research Inbox
          </h2>
          <p class="text-sm leading-relaxed mb-4">
            For corrections, questions about formula methodology, press inquiries, or to report regional changes to DoorDash dispatch rules:
          </p>
          <a
            href={`mailto:${SITE_CONFIG.contactEmail}`}
            class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg bg-brand-50 text-brand-700 dark:bg-brand-950/70 dark:text-brand-300 font-semibold border border-brand-200 dark:border-brand-800 hover:bg-brand-100 transition-colors"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <span>{SITE_CONFIG.contactEmail}</span>
          </a>
        </div>

        <div class="rounded-xl border border-slate-200 bg-slate-50 p-6 dark:border-slate-800 dark:bg-slate-900/40 text-sm">
          <h3 class="font-bold text-slate-900 dark:text-white mb-2">
            Important Note on Dasher Support
          </h3>
          <p class="text-slate-600 dark:text-slate-400 leading-relaxed">
            Please remember that {SITE_CONFIG.siteName} is an independent research website. <strong>We cannot assist with DoorDash account activations, app crashes, customer complaints, or missing platform payouts.</strong> For account support, contact official DoorDash Driver Support directly through your Dasher app.
          </p>
        </div>
      </div>

      <!-- General Feedback Form (Static-Friendly with Netlify/Formspree hook compatibility) -->
      <div class="rounded-2xl border border-slate-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-900 shadow-sm">
        <h2 class="text-xl font-bold text-slate-900 dark:text-white mb-4">
          Send Us a Note
        </h2>
        <form
          action={`mailto:${SITE_CONFIG.contactEmail}`}
          method="POST"
          enctype="text/plain"
          class="space-y-4"
        >
          <div>
            <label for="contact-name" class="block text-sm font-semibold text-slate-800 dark:text-slate-200 mb-1">
              Your Name / Dasher Handle
            </label>
            <input
              type="text"
              id="contact-name"
              name="name"
              required
              class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-900 focus:border-brand-500 focus:ring-1 focus:ring-brand-500 dark:border-slate-700 dark:bg-slate-800 dark:text-white min-h-[44px]"
            />
          </div>

          <div>
            <label for="contact-email" class="block text-sm font-semibold text-slate-800 dark:text-slate-200 mb-1">
              Email Address
            </label>
            <input
              type="email"
              id="contact-email"
              name="email"
              required
              class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-900 focus:border-brand-500 focus:ring-1 focus:ring-brand-500 dark:border-slate-700 dark:bg-slate-800 dark:text-white min-h-[44px]"
            />
          </div>

          <div>
            <label for="contact-topic" class="block text-sm font-semibold text-slate-800 dark:text-slate-200 mb-1">
              Topic
            </label>
            <select
              id="contact-topic"
              name="topic"
              class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-900 focus:border-brand-500 focus:ring-1 focus:ring-brand-500 dark:border-slate-700 dark:bg-slate-800 dark:text-white min-h-[44px]"
            >
              <option value="calculator">Calculator Formula Suggestion</option>
              <option value="rate-update">Gas / Rate Update</option>
              <option value="guide-correction">Guide Correction</option>
              <option value="general">General Inquiry</option>
            </select>
          </div>

          <div>
            <label for="contact-message" class="block text-sm font-semibold text-slate-800 dark:text-slate-200 mb-1">
              Message
            </label>
            <textarea
              id="contact-message"
              name="message"
              rows="4"
              required
              class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 focus:border-brand-500 focus:ring-1 focus:ring-brand-500 dark:border-slate-700 dark:bg-slate-800 dark:text-white"
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full rounded-lg bg-brand-500 py-3 px-4 text-center text-sm font-bold text-white shadow hover:bg-brand-600 transition-colors min-h-[44px]"
          >
            Submit Message
          </button>
        </form>
      </div>
    </div>
  </div>
</BaseLayout>
